{
	"$schema": "https://www.schemastore.org/package.json",
	"name": "@ozanarslan/native-jsx",
	"version": "0.1.0",
	"description": "Lowercase intrinsic elements for React Native",
	"bin": {
		"native-jsx": "./dist/cli/index.mjs"
	},
	"files": [
		"dist",
		"bin"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./jsx-dev-runtime": "./dist/jsx-dev-runtime.js",
		"./jsx-runtime": "./dist/jsx-runtime.js",
		"./nativewind": "./dist/nativewind/index.js",
		"./nativewind/jsx-dev-runtime": "./dist/nativewind/jsx-dev-runtime.js",
		"./nativewind/jsx-runtime": "./dist/nativewind/jsx-runtime.js",
		"./stylesheet": "./dist/stylesheet.js",
		"./package.json": "./package.json",
		"./babel": "./dist/babel/babel.cjs",
		"./eslint": {
			"types": "./dist/eslint/index.d.cts",
			"default": "./dist/eslint/index.cjs"
		},
		"./oxlint": {
			"types": "./dist/oxlint/index.d.cts",
			"default": "./dist/oxlint/index.cjs"
		}
	},
	"scripts": {
		"build": "tsdown",
		"fm": "oxfmt --write",
		"lint": "oxlint --fix",
		"knip": "knip",
		"test": "vitest run"
	},
	"dependencies": {
		"@babel/parser": "^7.29.9"
	},
	"devDependencies": {
		"@babel/types": "^7.29.8",
		"@types/node": "^26.6.2",
		"@types/react": "^19.2.2",
		"nativewind": "^4",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"react": "^19.2.3",
		"react-native": "^0.87.1",
		"tsdown": "^0.23.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.3"
	},
	"peerDependencies": {
		"babel-preset-expo": "*",
		"nativewind": "^4",
		"react": ">=19",
		"react-native": ">=0.86"
	},
	"peerDependenciesMeta": {
		"nativewind": {
			"optional": true
		}
	}
}
